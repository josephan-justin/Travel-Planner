<!DOCTYPE html>
<html lang="<%= travelPlan.language === 'id' ? 'id' : 'en' %>">

<head>
  <meta charset="UTF-8" />

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      font-family: Arial, sans-serif;
      color: #333;
      margin: 0;
      padding: 40px;
      line-height: 1.5;
    }

    h1 {
      margin-bottom: 5px;
      font-size: 28px;
    }

    h2 {
      margin-top: 30px;
      padding-bottom: 8px;
      border-bottom: 2px solid #333;
    }

    h3 {
      margin-bottom: 10px;
    }

    h4 {
      margin: 5px 0;
    }

    .header {
      margin-bottom: 30px;
    }

    .info {
      margin-bottom: 25px;
    }

    .info p {
      margin: 4px 0;
    }

    .day {
      margin-top: 25px;
      page-break-inside: avoid;
    }

    .activity {
      margin: 15px 0;
      padding: 12px;
      border: 1px solid #ddd;
      border-radius: 6px;
      page-break-inside: avoid;
    }

    .activity p {
      margin: 5px 0;
    }

    .budget-item {
      margin: 5px 0;
    }

    .tips {
      margin-top: 30px;
    }

    .tips li {
      margin-bottom: 8px;
    }
  </style>
</head>

<body>

  <!-- HEADER -->

  <div class="header">

    <h1>
      <%= travelPlan.title %>
    </h1>

    <p>
      <strong>
        <%= travelPlan.destination %>
      </strong>
    </p>

  </div>


  <!-- TRIP INFORMATION -->

  <div class="info">

    <% if (travelPlan.language === "id") { %>

      <p>
        <strong>Durasi:</strong>
        <%= travelPlan.duration %> hari
      </p>

      <p>
        <strong>Anggaran:</strong>
        Rp<%= Number(travelPlan.budget).toLocaleString("id-ID") %>
      </p>

      <p>
        <strong>Gaya Perjalanan:</strong>
        <%= travelPlan.travelStyle %>
      </p>

    <% } else { %>

      <p>
        <strong>Duration:</strong>
        <%= travelPlan.duration %> days
      </p>

      <p>
        <strong>Budget:</strong>
        Rp<%= Number(travelPlan.budget).toLocaleString("id-ID") %>
      </p>

      <p>
        <strong>Travel Style:</strong>
        <%= travelPlan.travelStyle %>
      </p>

    <% } %>

  </div>


  <!-- ITINERARY -->

  <% if (travelPlan.language === "id") { %>

    <h2>Rencana Perjalanan</h2>

  <% } else { %>

    <h2>Itinerary</h2>

  <% } %>


  <% travelPlan.Itineraries.forEach(itinerary => { %>

    <div class="day">

      <% if (travelPlan.language === "id") { %>

        <h3>
          Hari <%= itinerary.day %> - <%= itinerary.title %>
        </h3>

      <% } else { %>

        <h3>
          Day <%= itinerary.day %> - <%= itinerary.title %>
        </h3>

      <% } %>


      <% itinerary.activities.forEach(activity => { %>

        <div class="activity">

          <strong>
            <%= activity.time %>
          </strong>

          <h4>
            <%= activity.activity %>
          </h4>

          <p>
            <%= activity.description %>
          </p>


          <!-- ESTIMATED COST -->

          <% if (activity.estimated_cost_idr != null) { %>

            <p>

              <% if (travelPlan.language === "id") { %>

                <strong>Perkiraan Biaya:</strong>

              <% } else { %>

                <strong>Estimated Cost:</strong>

              <% } %>

              Rp<%= Number(activity.estimated_cost_idr).toLocaleString("id-ID") %>

            </p>

          <% } %>

        </div>

      <% }) %>

    </div>

  <% }) %>


  <!-- BUDGET BREAKDOWN -->

  <% if (travelPlan.budgetBreakdown) { %>

  <% if (travelPlan.language === "id") { %>
    <h2>Rincian Anggaran</h2>

  <% } else { %>
    
    <h2>Budget Breakdown</h2>
  <% } %>


  <% if (travelPlan.budgetBreakdown.categories) { %>

    <% travelPlan.budgetBreakdown.categories.forEach(category => { %>

      <div class="budget-item">

        <p>
          <strong>
            <%= category.category %>
          </strong>
        </p>

        <p>
          <% if (travelPlan.language === "id") { %>
            Perkiraan Biaya:
          <% } else { %>
            Estimated Cost:
          <% } %>

          Rp<%= Number(category.estimated_cost).toLocaleString("id-ID") %>
        </p>

        <p>
          <%= category.details %>
        </p>

      </div>

    <% }) %>

  <% } %>


  <% if (travelPlan.budgetBreakdown.total_budget != null) { %>

    <p class="budget-item">

      <% if (travelPlan.language === "id") { %>

        <strong>Total Anggaran:</strong>

      <% } else { %>

        <strong>Total Budget:</strong>

      <% } %>

      Rp<%= Number(
        travelPlan.budgetBreakdown.total_budget
      ).toLocaleString("id-ID") %>

    </p>

  <% } %>

<% } %>


  <!-- TRAVEL TIPS -->

  <div class="tips">

    <% if (travelPlan.language === "id") { %>

      <h2>Tips Perjalanan</h2>

    <% } else { %>

      <h2>Travel Tips</h2>

    <% } %>


    <% if (travelPlan.travelTips) { %>

      <ul>

        <% travelPlan.travelTips.forEach(tip => { %>

          <li>
            <%= tip %>
          </li>

        <% }) %>

      </ul>

    <% } %>

  </div>

</body>

</html>